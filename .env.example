PORT=3000
UPSTREAM_BASE=https://opendata.camara.cl/camaradiputados/WServices
UPSTREAM_TIMEOUT_MS=30000
CACHE_TTL_SECONDS=300

# Postgres (capa de datos persistente: espejo + caché analítica).
# Cualquier Postgres 15+ local o remoto. Sin DATABASE_URL la API funciona
# en modo upstream+caché en memoria (más lento, sin persistencia).
DATABASE_URL=postgresql://USUARIO:TU_PASSWORD@HOST:5432/camara

# Bot de alertas (opcional: sin token solo registra en consola)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
BOT_INTERVAL_MIN=15

# Dieta parlamentaria mensual usada para la estimación de "dieta de los ausentes"
DIETA_MENSUAL=8900000

# Pesos del score de rankings: asistencia, participación, mociones, avance.
# Se normalizan para sumar 1; si el formato es inválido se usan los de abajo.
SCORE_PESOS=0.4,0.25,0.2,0.15
